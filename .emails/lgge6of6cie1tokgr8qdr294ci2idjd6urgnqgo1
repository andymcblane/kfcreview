    /* subtle overlay for readability */
    .left-col::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(255,255,255,0.10);
      z-index: 1;
    }
    .left-col > * {
      position: relative;
      z-index: 2;
    }
    .left-col .preview-text {
      font-size: 22px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 4px;
    }
    .left-col .preview-sub {
      font-size: 15px;
      color: #6a6a6a;
    }

    /* right column (4/12) */
    .right-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px 12px;
      background: #ffffff;
      min-height: 300px;
      height: 100%;

    }
    .right-col .pdf-icon {
      margin-bottom: 8px;
    }
    .right-col .pdf-icon svg {
      width: 80px;
      height: 80px;
      display: block;
    }
    .right-col .file-name {
      font-size: 20px;
      font-weight: 600;
      color: #1a1a1a;
      text-align: center;
    }
    .right-col .file-type {
      font-size: 15px;
      font-weight: 400;
      color: #6a6a6a;
      text-align: center;
      margin-bottom: 18px;
    }
    .btn {
      display: inline-block;
      background: #0078d4;
      color: #ffffff;
      font-size: 16px;
      font-weight: 500;
      padding: 12px 40px;
      border-radius: 4px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background 0.15s;
      min-width: 160px;
      text-align: center;
    }
    .btn:hover {
      background: #005a9e;
    }

    /* footer */
    .footer {
      text-align: center;
